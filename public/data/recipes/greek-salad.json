  "steps": [
    {
      "title": "Нарезать овощи",
      "instruction": "Вымойте и обсушите овощи. Томаты нарежьте дольками, огурцы полукружьями, перец полосками, лук тонкими полукольцами. Резкий лук замочите на 5 минут и обсушите. Огурцы и помидоры не очищайте, если кожица тонкая. После мытья промокните их, чтобы заправка не разбавилась.",
      "ingredients": [
        "i1",
        "i2",
        "i3",
        "i4"
      ],
      "temperature": "",
      "ready": "Куски овощей крупные, лук тонкий.",
      "parallel": "",
      "timers": [
        {
          "name": "Смягчить лук при необходимости",
          "seconds": 300
        }
      ]
    },
    {
      "title": "Смешать заправку",
      "instruction": "Встряхните в баночке масло, лимонный сок, орегано и половину соли. Попробуйте с кусочком феты, остаток соли добавляйте по необходимости.",
      "ingredients": [
        "i5",
        "i7",
        "i8",
        "i9",
        "i10"
      ],
      "temperature": "",
      "ready": "Заправка помутнела и временно стала однородной.",
      "parallel": "",
      "timers": []
    },
    {
      "title": "Собрать салат",
      "instruction": "Добавьте оливки, полейте заправкой и перемешайте один-два раза. Фету раскрошите сверху. Подавайте сразу.",
      "ingredients": [
        "i1",
        "i2",
        "i3",
        "i4",
        "i5",
        "i6"
      ],
      "temperature": "",
      "ready": "Огурцы хрустят, в миске мало выделившегося сока.",
      "parallel": "",
      "timers": []
    }
  ],
  "tips": [
